// Earth Bank Dashboard schema.
//
// Conventions:
// - Models are PascalCase and @@map to snake_case tables; every field is snake_case so Prisma rows,
//   API JSON and form state look the same.
// - IDs are prefixed, time-sortable strings generated in app code (newId in server/utils/ids.ts),
//   never by the database.
// - Money is integer cents in USD, stored as BigInt (Prisma's Int is 32-bit, too small for
//   lending-capital amounts). Serializers convert to plain numbers at the API boundary.
// - The database URL comes from prisma.config.ts (derived from DATA_DIR).

generator client {
    provider            = "prisma-client"
    output              = "../server/generated/prisma"
    moduleFormat        = "esm"
    importFileExtension = "ts"
}

datasource db {
    provider = "sqlite"
}

model User {
    id                 String    @id
    // Null for invited guests outside the Workspace, who sign in with an emailed link instead.
    google_sub         String?   @unique
    email              String    @unique
    name               String
    // The Google profile picture (from sign-in or connecting Gmail); refreshed by Google sign-in.
    avatar_url         String?
    // A picture the person uploaded in Settings → Profile; shown instead of the Google one.
    avatar_storage_key String?
    avatar_updated_at  DateTime?
    role               String    @default("admin")
    // Personal preferences ({ color_mode }), validated by UserPreferences in shared/schemas/users.ts.
    settings           Json?
    // Set when someone invited this person by email (guests outside the Workspace).
    invited_at         DateTime?
    invited_by_id      String?
    last_sign_in_at    DateTime?
    deactivated_at     DateTime?
    created_at         DateTime  @default(now())
    updated_at         DateTime  @updatedAt

    invited_by    User?        @relation("user_inviter", fields: [invited_by_id], references: [id], onDelete: SetNull)
    invited_users User[]       @relation("user_inviter")
    sign_in_links SignInLink[]

    sessions                         Session[]
    audit_log                        AuditLog[]
    owned_funders                    Funder[]
    owned_opportunities              Opportunity[]
    change_events                    ChangeEvent[]         @relation("change_event_actor")
    resolved_changes                 ChangeEvent[]         @relation("change_event_resolver")
    assigned_tasks                   Task[]                @relation("task_assignee")
    created_tasks                    Task[]                @relation("task_creator")
    created_milestones               Milestone[]
    comments                         Comment[]
    attachments                      Attachment[]
    scenarios                        Scenario[]
    planned_expenses                 PlannedExpense[]
    mailbox_connection               MailboxConnection?
    email_evidence                   EmailEvidence[]
    knowledge_sources                KnowledgeSource[]
    share_links                      ShareLink[]
    owned_fund_managers              FundManager[]
    approved_fund_managers           FundManager[]         @relation("fund_approval")
    activity_confirmed_fund_managers FundManager[]         @relation("fund_activity_confirmation")
    emailed_fund_managers            FundManager[]         @relation("fund_last_email")
    rejected_findings                FundFinding[]
    diligence_answers                FundDiligenceAnswer[]
    fund_notes                       FundNote[]

    @@map("user")
}

model Session {
    id           String   @id
    user_id      String
    token_hash   String   @unique
    expires_at   DateTime
    ip           String?
    user_agent   String?
    created_at   DateTime @default(now())
    last_seen_at DateTime @default(now())

    user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@index([user_id])
    @@index([expires_at])
    @@map("session")
}

// A one-time sign-in link emailed to an invited guest (an invitation, or "email me a link" on the
// login page). Only the token's hash is stored.
model SignInLink {
    id         String    @id
    user_id    String
    token_hash String    @unique
    // invitation | sign_in
    purpose    String
    expires_at DateTime
    used_at    DateTime?
    created_at DateTime  @default(now())

    user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@index([user_id])
    @@index([expires_at])
    @@map("sign_in_link")
}

model AuditLog {
    id            String   @id
    actor_user_id String?
    action        String
    entity_type   String
    entity_id     String
    changes       Json?
    ip            String?
    created_at    DateTime @default(now())

    actor_user User? @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

    @@index([entity_type, entity_id])
    @@index([created_at])
    @@map("audit_log")
}

// An organization that might give or lend us money.
model Funder {
    id                  String    @id
    name                String
    // Lowercased, punctuation-free name; keeps "IKEA Foundation" and "Ikea foundation" as one funder.
    name_key            String    @unique
    // foundation | dfi | corporate | individual | government | other
    kind                String    @default("foundation")
    // t1 (hot) … t4 (target, no relationship)
    tier                String?
    // no_contact | early | active | advanced | committed | dead
    relationship_status String    @default("no_contact")
    geo_focus           String?
    // "Design Grant Only", "Above $10M", … as written in the pipeline sheet.
    potential_size      String?
    // Domains whose mail belongs to this funder (JSON array of strings); never free-mail domains.
    email_domains       Json      @default("[]")
    materials_sent_at   DateTime?
    last_contact_at     DateTime?
    last_contact_note   String?
    notes               String?
    owner_id            String?
    // active | draft (drafts are proposed by the AI from forwarded email and wait for review)
    status              String    @default("active")
    archived_at         DateTime?
    created_at          DateTime  @default(now())
    updated_at          DateTime  @updatedAt

    owner         User?           @relation(fields: [owner_id], references: [id], onDelete: SetNull)
    contacts      Contact[]
    opportunities Opportunity[]
    milestones    Milestone[]
    tasks         Task[]
    emails        EmailEvidence[]
    attachments   Attachment[]

    @@index([tier])
    @@index([relationship_status])
    @@map("funder")
}

// A person at a funder.
model Contact {
    id          String    @id
    funder_id   String
    name        String
    title       String?
    // Unique when present; SQLite allows many NULLs.
    email       String?   @unique
    notes       String?
    archived_at DateTime?
    created_at  DateTime  @default(now())
    updated_at  DateTime  @updatedAt

    funder Funder @relation(fields: [funder_id], references: [id], onDelete: Cascade)

    @@index([funder_id])
    @@map("contact")
}

// One of the three funding goals every opportunity counts toward.
model Goal {
    id                  String    @id
    // design_grant | opex | lending_capital
    type                String    @unique
    name                String
    target_amount_cents BigInt?
    target_date         DateTime?
    notes               String?
    sort                Int       @default(0)
    created_at          DateTime  @default(now())
    updated_at          DateTime  @updatedAt

    opportunities Opportunity[]
    milestones    Milestone[]

    @@map("goal")
}

// One ask to one funder for one goal.
model Opportunity {
    id                   String    @id
    funder_id            String
    goal_id              String
    name                 String
    // identified | in_discussion | proposal | due_diligence | in_committee | committed (shown as
    // "Approved") | received | lost (shown as "Declined")
    stage                String    @default("identified")
    amount_cents         BigInt?
    // 0–100; when null the stage's default probability applies.
    probability_override Int?
    expected_decision_at DateTime?
    expected_receipt_at  DateTime?
    // When it went to the funder's committee (set when the stage moves to in_committee).
    committee_on         DateTime?
    // Geographic focus: country codes ("KE"), regions ("region:eastern_africa") or "global".
    focus_areas          Json      @default("[]")
    received_at          DateTime?
    next_step            String?
    owner_id             String?
    archived_at          DateTime?
    created_at           DateTime  @default(now())
    updated_at           DateTime  @updatedAt

    funder      Funder       @relation(fields: [funder_id], references: [id], onDelete: Cascade)
    goal        Goal         @relation(fields: [goal_id], references: [id])
    owner       User?        @relation(fields: [owner_id], references: [id], onDelete: SetNull)
    milestones  Milestone[]
    tasks       Task[]
    attachments Attachment[]

    @@index([funder_id])
    @@index([goal_id, stage])
    @@map("opportunity")
}

// Every change to a tracked funder or opportunity field, from any source. Written only through
// applyFieldChanges (server/utils/change-events.ts) so the Activity log is complete.
model ChangeEvent {
    id                  String    @id
    // funder | opportunity
    entity_type         String
    entity_id           String
    field               String
    from_value          Json?
    to_value            Json?
    // manual | import | ai_email | ai_forward | ai_instruction | ai_document
    source              String
    // applied | pending | rejected | reverted | superseded
    status              String
    actor_user_id       String?
    evidence_id         String?
    // The funder file the AI read, for ai_document changes.
    attachment_id       String?
    reason              String?
    confidence          Float?
    resolved_at         DateTime?
    resolved_by_user_id String?
    created_at          DateTime  @default(now())

    actor_user       User?          @relation("change_event_actor", fields: [actor_user_id], references: [id], onDelete: SetNull)
    resolved_by_user User?          @relation("change_event_resolver", fields: [resolved_by_user_id], references: [id], onDelete: SetNull)
    evidence         EmailEvidence? @relation(fields: [evidence_id], references: [id], onDelete: SetNull)
    attachment       Attachment?    @relation(fields: [attachment_id], references: [id], onDelete: SetNull)

    @@index([entity_type, entity_id, field])
    @@index([status])
    @@index([source])
    @@map("change_event")
}

// Small app-wide settings (stage probabilities, burn settings), validated by zod in app code.
model Setting {
    key        String   @id
    value      Json
    updated_at DateTime @updatedAt

    @@map("setting")
}

// A dated funding milestone or event ("UBS decision", "NY Climate Week") that tasks roll up to.
// It also appears as a marker on the runway forecast.
model Milestone {
    id             String    @id
    title          String
    description    String?
    due_at         DateTime
    // funding | event | internal
    kind           String    @default("funding")
    // open | done
    status         String    @default("open")
    goal_id        String?
    opportunity_id String?
    // Set from the opportunity when there is one, so funder pages find their milestones directly.
    funder_id      String?
    created_by_id  String?
    archived_at    DateTime?
    created_at     DateTime  @default(now())
    updated_at     DateTime  @updatedAt

    goal        Goal?        @relation(fields: [goal_id], references: [id], onDelete: SetNull)
    opportunity Opportunity? @relation(fields: [opportunity_id], references: [id], onDelete: SetNull)
    funder      Funder?      @relation(fields: [funder_id], references: [id], onDelete: SetNull)
    created_by  User?        @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
    tasks       Task[]

    @@index([due_at])
    @@index([funder_id])
    @@map("milestone")
}

// Something a person has to do, usually for a milestone.
model Task {
    id             String    @id
    title          String
    description    String?
    // todo | doing | done
    status         String    @default("todo")
    assignee_id    String?
    due_at         DateTime?
    milestone_id   String?
    opportunity_id String?
    // Set from the opportunity (or milestone) when there is one.
    funder_id      String?
    // Order within a milestone; lower first.
    sort           Int       @default(0)
    completed_at   DateTime?
    created_by_id  String?
    archived_at    DateTime?
    created_at     DateTime  @default(now())
    updated_at     DateTime  @updatedAt

    assignee    User?        @relation("task_assignee", fields: [assignee_id], references: [id], onDelete: SetNull)
    created_by  User?        @relation("task_creator", fields: [created_by_id], references: [id], onDelete: SetNull)
    milestone   Milestone?   @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
    opportunity Opportunity? @relation(fields: [opportunity_id], references: [id], onDelete: SetNull)
    funder      Funder?      @relation(fields: [funder_id], references: [id], onDelete: SetNull)
    comments    Comment[]
    attachments Attachment[]

    @@index([assignee_id, status])
    @@index([milestone_id])
    @@index([funder_id])
    @@index([due_at])
    @@map("task")
}

model Comment {
    id         String    @id
    task_id    String
    author_id  String?
    body       String
    edited_at  DateTime?
    deleted_at DateTime?
    created_at DateTime  @default(now())

    task        Task         @relation(fields: [task_id], references: [id], onDelete: Cascade)
    author      User?        @relation(fields: [author_id], references: [id], onDelete: SetNull)
    attachments Attachment[]

    @@index([task_id])
    @@map("comment")
}

// A file on a task, a funder (optionally one of its asks) or a fund. The bytes live on disk under
// DATA_DIR/files at storage_key. Exactly one of task_id, funder_id and fund_manager_id is set.
// Funder and fund files (usually PDFs) are read by the AI into the pipeline or the fund's research.
model Attachment {
    id                String    @id
    task_id           String?
    // Set when the file was attached to a comment rather than to the task itself.
    comment_id        String?
    funder_id         String?
    // The ask a funder file is about, when someone said (or the AI could tell).
    opportunity_id    String?
    fund_manager_id   String?
    uploaded_by_id    String?
    filename          String
    content_type      String
    size_bytes        Int
    storage_key       String
    // upload | email (an attachment on an email sent to the dashboard address)
    origin            String    @default("upload")
    // Resend's id for the received email it came from, so an email's files are filed once.
    received_email_id String?
    // How the AI reading went: null (task files aren't read) | queued | reading | done | skipped | failed
    read_status       String?
    // What the AI took from it (≤ 300 characters), or why it was skipped or failed.
    read_summary      String?
    read_error        String?
    // { facts, people, diligence, applied, pending, contacts }: what reading it added.
    read_counts       Json?
    read_at           DateTime?
    deleted_at        DateTime?
    created_at        DateTime  @default(now())

    task          Task?         @relation(fields: [task_id], references: [id], onDelete: Cascade)
    comment       Comment?      @relation(fields: [comment_id], references: [id], onDelete: SetNull)
    funder        Funder?       @relation(fields: [funder_id], references: [id], onDelete: Cascade)
    opportunity   Opportunity?  @relation(fields: [opportunity_id], references: [id], onDelete: SetNull)
    fund_manager  FundManager?  @relation(fields: [fund_manager_id], references: [id], onDelete: Cascade)
    uploaded_by   User?         @relation(fields: [uploaded_by_id], references: [id], onDelete: SetNull)
    fund_notes    FundNote[]
    change_events ChangeEvent[]

    @@index([task_id])
    @@index([comment_id])
    @@index([funder_id])
    @@index([fund_manager_id])
    @@index([received_email_id])
    @@map("attachment")
}

// A bank (or card) account synced from Bookeeping.ai.
model BankAccount {
    id             String    @id
    external_id    String    @unique
    name           String
    // Depository | Credit | Loan | Investment | Other (Bookeeping.ai's account types)
    account_type   String
    currency       String    @default("USD")
    // Whether this account counts toward cash on hand and runway.
    is_included    Boolean   @default(true)
    last_synced_at DateTime?
    created_at     DateTime  @default(now())
    updated_at     DateTime  @updatedAt

    snapshots    BalanceSnapshot[]
    transactions BankTransaction[]

    @@map("bank_account")
}

// One account's balance on one day (today's sync, or a month-end from Bookeeping.ai's history).
model BalanceSnapshot {
    id              String   @id
    bank_account_id String
    as_of           DateTime
    balance_cents   BigInt
    // institution (the bank's own figure) | accounting (Bookeeping.ai's ledger)
    source          String
    created_at      DateTime @default(now())

    bank_account BankAccount @relation(fields: [bank_account_id], references: [id], onDelete: Cascade)

    @@unique([bank_account_id, as_of])
    @@map("balance_snapshot")
}

// One transaction, signed from the bank account's point of view: + money in, - money out.
model BankTransaction {
    id                    String    @id
    external_id           String    @unique
    bank_account_id       String?
    booked_on             DateTime
    amount_cents          BigInt
    description           String?
    counterparty_name     String?
    category_name         String?
    // Bookeeping.ai parent category of the non-bank side: EXPENSE, INCOME, CURRENT_ASSET (transfers), …
    parent_category       String?
    // Set by a person to leave a one-off (e.g. a loan repayment) out of the burn rate.
    is_excluded_from_burn Boolean   @default(false)
    source_updated_at     DateTime?
    created_at            DateTime  @default(now())
    updated_at            DateTime  @updatedAt

    bank_account BankAccount? @relation(fields: [bank_account_id], references: [id], onDelete: SetNull)

    @@index([booked_on])
    @@map("bank_transaction")
}

// A named what-if for the runway forecast; adjustments are validated by zod (shared/schemas/scenarios.ts).
model Scenario {
    id            String    @id
    name          String
    description   String?
    adjustments   Json      @default("[]")
    created_by_id String?
    archived_at   DateTime?
    created_at    DateTime  @default(now())
    updated_at    DateTime  @updatedAt

    created_by User? @relation(fields: [created_by_id], references: [id], onDelete: SetNull)

    @@map("scenario")
}

// A team member's connected Gmail. Only the encrypted refresh token is kept; mail is fetched on demand.
model MailboxConnection {
    id                      String    @id
    user_id                 String    @unique
    google_email            String
    refresh_token_encrypted String
    scopes                  String
    // active | error (token revoked or expired; the user reconnects)
    status                  String    @default("active")
    last_synced_at          DateTime?
    last_error              String?
    // Progress of the current sync, for Settings → Email: idle | queued | running
    sync_state              String    @default("idle")
    // searching | checking | reading (while running)
    sync_phase              String?
    sync_done               Int       @default(0)
    sync_total              Int?
    sync_started_at         DateTime?
    // { matched, processed, applied, pending, finished_at } of the last finished sync
    last_sync_result        Json?
    created_at              DateTime  @default(now())
    updated_at              DateTime  @updatedAt

    user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@map("mailbox_connection")
}

// What the dashboard keeps about an email it read: who, when, and an AI summary. Never the body.
model EmailEvidence {
    id                String   @id
    // gmail | forward
    source            String
    // RFC 5322 Message-ID, so the same email in two inboxes is processed once.
    message_id_header String   @unique
    mailbox_user_id   String?
    from_address      String
    to_addresses      Json     @default("[]")
    sent_at           DateTime
    // Hidden (null) when the AI marks the email sensitive.
    subject           String?
    summary           String
    is_relevant       Boolean  @default(true)
    is_sensitive      Boolean  @default(false)
    funder_id         String?
    model             String?
    confidence        Float?
    created_at        DateTime @default(now())

    mailbox_user  User?         @relation(fields: [mailbox_user_id], references: [id], onDelete: SetNull)
    funder        Funder?       @relation(fields: [funder_id], references: [id], onDelete: SetNull)
    change_events ChangeEvent[]

    @@index([funder_id, sent_at])
    @@map("email_evidence")
}

// A user's private forwarding address: updates+<token>@INBOUND_EMAIL_DOMAIN.

// A Google Drive folder whose documents inform AI-drafted emails. Read with the refresh token of the
// person who connected it (drive.readonly). Only files inside the folder are ever read.
model KnowledgeSource {
    id                      String    @id
    // A Drive folder (everything inside it is read) or a single file.
    drive_item_id           String    @unique
    // folder | file
    kind                    String    @default("folder")
    name                    String
    connected_by_id         String?
    // Empty when access was removed (the person was deactivated); someone reconnects the folder.
    refresh_token_encrypted String
    // active | error
    status                  String    @default("active")
    last_synced_at          DateTime?
    last_error              String?
    created_at              DateTime  @default(now())
    updated_at              DateTime  @updatedAt

    connected_by User?               @relation(fields: [connected_by_id], references: [id], onDelete: SetNull)
    documents    KnowledgeDocument[]

    @@map("knowledge_source")
}

// One file from a knowledge folder, with its extracted text. These are Earth Bank's own business
// documents (models, explainers), so unlike email the text is stored.
model KnowledgeDocument {
    id               String   @id
    source_id        String
    drive_file_id    String   @unique
    name             String
    mime_type        String
    web_view_link    String?
    // Drive's modifiedTime; a file is only downloaded again when this changes.
    modified_at      DateTime
    // indexed | unsupported | too_large | failed | sensitive
    status           String
    // Why a file was skipped as sensitive (an ID, a tax form…); its text is never stored.
    sensitive_reason String?
    text             String?
    char_count       Int      @default(0)
    // Pinned documents are always given to the AI in full; excluded ones never are.
    is_pinned        Boolean  @default(false)
    is_excluded      Boolean  @default(false)
    synced_at        DateTime
    created_at       DateTime @default(now())
    updated_at       DateTime @updatedAt

    source KnowledgeSource @relation(fields: [source_id], references: [id], onDelete: Cascade)

    @@index([source_id])
    @@map("knowledge_document")
}

// A spending decision the team has made but not paid yet (a research study, an event, a new
// contract). Part of the base forecast, unlike scenario what-ifs.
model PlannedExpense {
    id            String    @id
    label         String
    // one_off | monthly
    kind          String
    // Positive cents: the one-off amount, or the amount per month.
    amount_cents  BigInt
    // The payment date (one-off) or the first month (monthly).
    starts_on     DateTime
    // Last month of a monthly expense; null = open-ended. Unused for one-offs.
    ends_on       DateTime?
    notes         String?
    created_by_id String?
    archived_at   DateTime?
    created_at    DateTime  @default(now())
    updated_at    DateTime  @updatedAt

    created_by User? @relation(fields: [created_by_id], references: [id], onDelete: SetNull)

    @@index([starts_on])
    @@map("planned_expense")
}

// A secret, password-protected link that shows funders a read-only summary of the pipeline.
model ShareLink {
    id                 String    @id
    label              String
    // Looked up by hash; the encrypted copy lets Settings show the link again.
    token_hash         String    @unique
    token_encrypted    String
    // scrypt: "scrypt$<salt>$<hash>", both base64url. Null: no password, the secret URL alone opens it.
    password_hash      String?
    // The team can see the password again in Settings (it isn't a secret from them); null for links
    // made before passwords were kept.
    password_encrypted String?
    show_next_steps    Boolean   @default(true)
    // Which parts of the page this link shows (ShareSections, validated in app code); null = all.
    sections           Json?
    created_by_user_id String?
    last_viewed_at     DateTime?
    revoked_at         DateTime?
    created_at         DateTime  @default(now())

    created_by User? @relation(fields: [created_by_user_id], references: [id], onDelete: SetNull)

    @@map("share_link")
}

// ---------------------------------------------------------------------------------------------
// Fund research: lenders Earth Bank might partner with. Two layers stay apart on every profile:
// Research (FundFinding rows the AI found, each linked to the pages it came from) and Due Diligence
// (FundDiligenceAnswer rows people enter; the AI may pre-fill one but never overwrites a person's).
// ---------------------------------------------------------------------------------------------

// A lender (debt fund, impact fund, CDFI, mission bank, fintech lender) being considered as a partner.
model FundManager {
    id                  String    @id
    name                String
    // Lowercased, punctuation-free name for de-duplication (normalizeOrganizationName).
    name_key            String    @unique
    // When the displayed name was tidied (capitalization, legal forms) by the AI name check or a person;
    // null for names nobody has checked yet.
    name_checked_at     DateTime?
    website_url         String?
    // Bare host without "www.", also used for de-duplication.
    website_domain      String?   @unique
    // The fund's LinkedIn company page (given when added, or found by research).
    linkedin_url        String?
    // pending | approved. Funds the spider finds wait as pending (not researched, not on the board or
    // map) until someone approves them; funds people add are approved.
    approval_status     String    @default("approved")
    approved_at         DateTime?
    approved_by_id      String?
    // The AI screen of a spider find (lends where and to whom, and whether that fits Earth Bank): when it
    // ran, its one-line reason, and when it archived the fund as outside Earth Bank's focus.
    screened_at         DateTime?
    screening_note      String?
    screened_out_at     DateTime?
    // new_addition | sourced | in_diligence | shortlisted | passed
    stage               String    @default("new_addition")
    // FUND_FIT_TAGS keys.
    fit_tags            Json      @default("[]")
    notes               String?
    owner_id            String?
    // seed | manual | spider_person | spider_public_record | spider_suggestion
    origin              String    @default("manual")
    discovered_from_id  String?
    // How the fund came up (e.g. "co-lender on a 2024 loan in Kenya", "BII investee: SME lending, Ghana")
    // or the team's region hint for seeds; used to find the right website for common names.
    discovery_context   String?
    // Website and LinkedIn candidates the research couldn't choose between, for a person to confirm.
    identity_candidates Json      @default("[]")
    // queued | running | done | failed | skipped
    research_status     String    @default("queued")
    research_queued_at  DateTime?
    researched_at       DateTime?
    research_error      String?
    archived_at         DateTime?

    // Current research values, recomputed from active findings after every run (for sorting and filtering).
    summary                        String?
    aum_cents                      BigInt?
    latest_fund_size_cents         BigInt?
    last_fund_close_on             DateTime?
    check_min_cents                BigInt?
    check_max_cents                BigInt?
    has_working_capital_loans      Boolean   @default(false)
    max_working_capital_loan_cents BigInt?
    year_established               Int?
    hq_country                     String?
    hq_city                        String?
    employee_count                 Int?
    // Headcount band as a data provider gives it (e.g. "11-50"), when there's no exact count.
    employee_range                 String?
    sectors                        Json      @default("[]")
    loan_types                     Json      @default("[]")
    // Effective regional focus (codes) used for the list, filters and map: the team's choice when they
    // set one, else what research found.
    focus_areas                    Json      @default("[]")
    // Regional focus the team set by hand (overrides research; null means "use research").
    team_focus_areas               Json?
    // LENDER_ARCHETYPES key.
    lender_archetype               String?
    // direct | on_lending | both
    lending_channel                String?
    lends_local_currency           Boolean   @default(false)
    // How the check-size range compares with Earth Bank's $500K–$5M ticket: fits | partly | outside.
    ticket_fit                     String?
    // The team's criteria for a lender worth researching (FUND_FIT_SIGNALS → met | not_met | unknown) and
    // how many are met; null until worked out from research.
    fit_signals                    Json?
    // The newest dated public activity research found (news, deal, fund close, AUM or impact report,
    // conference, DFI record); none in 12 months suggests the fund may have closed.
    last_public_activity_on        DateTime?
    // The newest email with the fund's website domain in a connected Gmail (date only; the email isn't
    // read), and whose mailbox it was in.
    last_email_on                  DateTime?
    last_email_user_id             String?
    // When a team member confirmed the fund is still operating ("Still active").
    activity_confirmed_at          DateTime?
    activity_confirmed_by_id       String?
    // The newest of the three (research, email, confirmation) and which it was: research | email | team.
    last_activity_on               DateTime?
    last_activity_source           String?
    fit_signals_met                Int       @default(0)
    research_completeness          Int       @default(0)
    diligence_completeness         Int       @default(0)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    owner                 User?                    @relation(fields: [owner_id], references: [id], onDelete: SetNull)
    approved_by           User?                    @relation("fund_approval", fields: [approved_by_id], references: [id], onDelete: SetNull)
    activity_confirmed_by User?                    @relation("fund_activity_confirmation", fields: [activity_confirmed_by_id], references: [id], onDelete: SetNull)
    last_email_user       User?                    @relation("fund_last_email", fields: [last_email_user_id], references: [id], onDelete: SetNull)
    discovered_from       FundManager?             @relation("fund_discovery", fields: [discovered_from_id], references: [id], onDelete: SetNull)
    discovered            FundManager[]            @relation("fund_discovery")
    findings              FundFinding[]
    people                FundPerson[]
    diligence_answers     FundDiligenceAnswer[]
    research_runs         FundResearchRun[]
    imported_notes        FundNote[]
    attachments           Attachment[]
    organization          ResearchOrganization?
    public_records        PublicInvestmentRecord[]

    @@index([stage])
    @@index([approval_status])
    @@index([fit_signals_met])
    @@index([research_status])
    @@map("fund_manager")
}

// One sourced research fact. List fields (deals, LPs, news, …) have one row per item.
model FundFinding {
    id                  String    @id
    fund_manager_id     String
    // FUND_RESEARCH_FIELDS key.
    field               String
    // Validated per field by FUND_FINDING_VALUE_SCHEMAS (shared/schemas/fund-findings.ts).
    value               Json
    // Normalized value for "same finding" checks (supersede, rejected values).
    value_key           String
    confidence          Float
    // active | superseded | rejected
    status              String    @default("active")
    research_run_id     String?
    rejected_by_user_id String?
    rejected_at         DateTime?
    created_at          DateTime  @default(now())

    fund_manager FundManager         @relation(fields: [fund_manager_id], references: [id], onDelete: Cascade)
    research_run FundResearchRun?    @relation(fields: [research_run_id], references: [id], onDelete: SetNull)
    rejected_by  User?               @relation(fields: [rejected_by_user_id], references: [id], onDelete: SetNull)
    sources      FundFindingSource[]

    @@index([fund_manager_id, field, status])
    @@map("fund_finding")
}

// A public page the research assistant actually retrieved.
model FundSource {
    id           String   @id
    url          String   @unique
    title        String?
    // fund_website | linkedin | news | press_release | dfi_database | government_database | report | data_provider | other
    kind         String   @default("other")
    retrieved_at DateTime
    created_at   DateTime @default(now())

    findings     FundFindingSource[]
    people       FundPersonSource[]
    affiliations FundAffiliationSource[]

    @@map("fund_source")
}

model FundFindingSource {
    finding_id String
    source_id  String
    // The passage that supports the finding (checked against the page text), at most 300 characters.
    quote      String?

    finding FundFinding @relation(fields: [finding_id], references: [id], onDelete: Cascade)
    source  FundSource  @relation(fields: [source_id], references: [id], onDelete: Cascade)

    @@id([finding_id, source_id])
    @@map("fund_finding_source")
}

// A principal or team member at a fund, from public sources.
model FundPerson {
    id              String   @id
    fund_manager_id String
    name            String
    name_key        String
    title           String?
    is_principal    Boolean  @default(false)
    linkedin_url    String?
    // Only an address the fund itself publishes; never guessed.
    email           String?
    bio_summary     String?
    created_at      DateTime @default(now())
    updated_at      DateTime @updatedAt

    fund_manager FundManager        @relation(fields: [fund_manager_id], references: [id], onDelete: Cascade)
    sources      FundPersonSource[]
    affiliations FundAffiliation[]

    @@unique([fund_manager_id, name_key])
    @@map("fund_person")
}

model FundPersonSource {
    person_id String
    source_id String
    quote     String?

    person FundPerson @relation(fields: [person_id], references: [id], onDelete: Cascade)
    source FundSource @relation(fields: [source_id], references: [id], onDelete: Cascade)

    @@id([person_id, source_id])
    @@map("fund_person_source")
}

// A node in the team network graph: a past employer, school, investor or other organization.
model ResearchOrganization {
    id              String    @id
    name            String
    name_key        String    @unique
    // lender | investor | bank | dfi | government | school | company | other
    kind            String    @default("other")
    website_domain  String?
    // Set when this organization has its own fund profile.
    fund_manager_id String?   @unique
    // When the spider decided whether this is a lender (so it isn't asked twice).
    classified_at   DateTime?
    created_at      DateTime  @default(now())

    fund_manager FundManager?      @relation(fields: [fund_manager_id], references: [id], onDelete: SetNull)
    affiliations FundAffiliation[]

    @@map("research_organization")
}

// A person's employer, school or board seat.
model FundAffiliation {
    id              String   @id
    person_id       String
    organization_id String
    // employment | education | board
    relation        String   @default("employment")
    title           String?
    start_year      Int?
    end_year        Int?
    created_at      DateTime @default(now())

    person       FundPerson              @relation(fields: [person_id], references: [id], onDelete: Cascade)
    organization ResearchOrganization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
    sources      FundAffiliationSource[]

    @@unique([person_id, organization_id, relation])
    @@map("fund_affiliation")
}

model FundAffiliationSource {
    affiliation_id String
    source_id      String
    quote          String?

    affiliation FundAffiliation @relation(fields: [affiliation_id], references: [id], onDelete: Cascade)
    source      FundSource      @relation(fields: [source_id], references: [id], onDelete: Cascade)

    @@id([affiliation_id, source_id])
    @@map("fund_affiliation_source")
}

// A Due Diligence answer. A person's answer (source manual) is never replaced by the AI.
model FundDiligenceAnswer {
    id                  String   @id
    fund_manager_id     String
    // FUND_DILIGENCE_QUESTIONS key.
    question            String
    answer              String
    // manual | ai
    source              String   @default("manual")
    source_urls         Json     @default("[]")
    answered_by_user_id String?
    // The imported call note this answer came from, if any (credited "Note from … on …").
    fund_note_id        String?
    created_at          DateTime @default(now())
    updated_at          DateTime @updatedAt

    fund_manager FundManager @relation(fields: [fund_manager_id], references: [id], onDelete: Cascade)
    answered_by  User?       @relation(fields: [answered_by_user_id], references: [id], onDelete: SetNull)
    fund_note    FundNote?   @relation(fields: [fund_note_id], references: [id], onDelete: SetNull)

    @@unique([fund_manager_id, question])
    @@map("fund_diligence_answer")
}

// A call note (or other document) someone imported on a fund's Import tab. The AI fills research
// fields and diligence answers from it, quoting it; facts are credited "Note from {author} on {time}".
// Its text is kept so the quotes can be checked and the note re-read (Earth Bank's own notes).
model FundNote {
    id                 String   @id
    fund_manager_id    String
    author_user_id     String?
    // pasted | google_doc | attachment (a file uploaded or emailed to the fund)
    origin             String
    doc_url            String?
    attachment_id      String?
    // "Note from Drew on Oct 18, 2026, 3:04 PM", in the author's time zone at import.
    title              String
    text               String
    // running | done | failed
    status             String   @default("running")
    error              String?
    findings_added     Int      @default(0)
    people_added       Int      @default(0)
    diligence_answered Int      @default(0)
    dropped            Int      @default(0)
    // Diligence answers the note gave where a person had already answered: [{ question, answer }].
    kept_existing      Json     @default("[]")
    created_at         DateTime @default(now())
    updated_at         DateTime @updatedAt

    fund_manager      FundManager           @relation(fields: [fund_manager_id], references: [id], onDelete: Cascade)
    author            User?                 @relation(fields: [author_user_id], references: [id], onDelete: SetNull)
    attachment        Attachment?           @relation(fields: [attachment_id], references: [id], onDelete: SetNull)
    diligence_answers FundDiligenceAnswer[]

    @@index([fund_manager_id, created_at])
    @@map("fund_note")
}

// One piece of paid AI work for fund research: researching a fund, reading a public investment list,
// or deciding whether spidered organizations are lenders. Its cost feeds the monthly budget.
model FundResearchRun {
    id                String    @id
    // fund | public_list | classification
    kind              String    @default("fund")
    fund_manager_id   String?
    // The public list read (kind public_list).
    source_key        String?
    // running | done | failed | skipped
    status            String    @default("running")
    model             String?
    started_at        DateTime
    finished_at       DateTime?
    input_tokens      Int       @default(0)
    output_tokens     Int       @default(0)
    web_searches      Int       @default(0)
    web_fetches       Int       @default(0)
    // Firecrawl credits (pages read with a full browser, web searches); their cost is in cost_micro_usd.
    firecrawl_credits Int       @default(0)
    cost_micro_usd    Int       @default(0)
    findings_added    Int       @default(0)
    findings_dropped  Int       @default(0)
    funds_discovered  Int       @default(0)
    error             String?

    fund_manager FundManager?  @relation(fields: [fund_manager_id], references: [id], onDelete: Cascade)
    findings     FundFinding[]

    @@index([fund_manager_id])
    @@index([started_at])
    @@map("fund_research_run")
}

// One row from a DFI or government list of investments and grants.
model PublicInvestmentRecord {
    id                 String    @id
    source_key         String
    external_id        String
    url                String?
    recipient_name     String
    recipient_name_key String
    amount_cents       BigInt?
    currency           String?
    original_amount    Float?
    committed_on       DateTime?
    country            String?
    instrument         String?
    description        String?
    // True when the recipient looks like a lender or fund (a spider candidate).
    is_intermediary    Boolean   @default(false)
    fund_manager_id    String?
    created_at         DateTime  @default(now())
    updated_at         DateTime  @updatedAt

    fund_manager FundManager? @relation(fields: [fund_manager_id], references: [id], onDelete: SetNull)

    @@unique([source_key, external_id])
    @@index([recipient_name_key])
    @@index([fund_manager_id])
    @@map("public_investment_record")
}

// Sync state for one public investment list.
model PublicInvestmentSource {
    key            String    @id
    // idle | running | error
    status         String    @default("idle")
    // Where the next sync resumes (a page URL or page number), so long lists are read over several runs.
    cursor         String?
    last_synced_at DateTime?
    last_error     String?
    updated_at     DateTime  @updatedAt

    @@map("public_investment_source")
}
