{
    "name": "earthbank-dashboard",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "imports": {
        "#root/*": "./*",
        "#server/*": "./server/*",
        "#shared/*": "./shared/*"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "start": "node .output/server/index.mjs",
        "start:render": "prisma migrate deploy && node .output/server/index.mjs",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare && prisma generate",
        "db:migrate": "prisma migrate dev",
        "typecheck": "nuxt typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "import:pipeline": "tsx scripts/import-pipeline.ts",
        "eval:classify-email": "tsx scripts/eval-classify-email.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "0.132.1",
        "@googleapis/drive": "26.0.2",
        "@googleapis/gmail": "22.0.1",
        "@iconify-json/lucide": "1.2.142",
        "@nuxt/ui": "4.11.3",
        "@prisma/adapter-better-sqlite3": "7.10.0",
        "@prisma/client": "7.10.0",
        "@scalar/api-reference": "1.73.1",
        "@sidequest/sqlite-backend": "1.16.6",
        "@vueuse/core": "15.0.0",
        "@vueuse/integrations": "15.0.0",
        "better-sqlite3": "12.11.1",
        "fflate": "0.8.3",
        "google-auth-library": "11.2.0",
        "h3": "1.15.11",
        "mammoth": "1.13.0",
        "nitropack": "2.13.4",
        "nuxt": "4.6.0",
        "nuxt-charts": "2.2.3",
        "read-excel-file": "9.3.12",
        "resend": "6.32.1",
        "sidequest": "1.16.6",
        "sortablejs": "1.15.7",
        "tailwindcss": "4.3.3",
        "unpdf": "1.8.1",
        "vue": "3.5.43",
        "vue-router": "5.4.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/better-sqlite3": "7.6.13",
        "@types/node": "24.19.1",
        "@types/sortablejs": "1.15.9",
        "esbuild": "0.28.2",
        "prettier": "3.9.9",
        "prisma": "7.10.0",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "vitest": "5.0.3",
        "vue-tsc": "3.3.12"
    }
}
